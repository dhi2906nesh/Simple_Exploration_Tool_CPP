  n20 [label="cout \<\< endl;"];
  n21 [label="cout \<\< \"\\n=== Number Classification ===\\n\";"];
  n22 [label="int evenCount = 0, oddCount = 0, primeCount = 0;"];
  n23 [label="int i = 1;"];
  n24 [label="while (i \<= n)"];
  n25 [label="if (i % 2 == 0) {"];
  n26 [label="cout \<\< i \<\< \" is Even.\" \<\< endl;"];
  n27 [label="evenCount++;"];
  n28 [label="} else {"];
  n29 [label="cout \<\< i \<\< \" is Odd.\" \<\< endl;"];
  n30 [label="oddCount++;"];
  n31 [label="if (isPrime(i)) {"];
  n32 [label="cout \<\< \" --\> \" \<\< i \<\< \" is also a Prime number!\" \<\< endl;"];
  n33 [label="primeCount++;"];
  n34 [label="i++;"];
  n35 [label="cout \<\< \"\\n=== Summary ===\" \<\< endl;"];
  n36 [label="cout \<\< \"Even numbers: \" \<\< evenCount \<\< endl;"];
  n37 [label="cout \<\< \"Odd numbers: \" \<\< oddCount \<\< endl;"];
  n38 [label="cout \<\< \"Prime numbers: \" \<\< primeCount \<\< endl;"];
  n39 [label="cout \<\< \"\\n=== Countdown using do-while ===\" \<\< endl;"];
  n40 [label="int k = n;"];
  n41 [label="do {"];
  n42 [label="if (k % 5 == 0)"];
  n43 [label="cout \<\< k \<\< \" is divisible by 5.\" \<\< endl;"];
  n44 [label="else if (k % 3 == 0)"];
